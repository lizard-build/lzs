#!/usr/bin/env node
// lzs: coding agents (Claude Code, Codex, OpenCode) in Lizard sandboxes, one command per session.
//
//   lzs init                     build your base snapshot once (agent login, skills, MCPs, tmux)
//   lzs .                        this repo (uncommitted work too) in a fresh sandbox, agent attached
//   lzs fan 10 . -p "task"       ten agents on the same task, in parallel, in the background
//   lzs watch                    what every agent is doing; a bell when one needs you
//   lzs pull <name>              the agent's work back here as a git branch
//
// Everything goes through the `lizard` CLI (npm i -g @lizard-build/cli; `lizard login` once).
// Each session is its own sandbox; the agent runs in tmux inside it, so it keeps working when your
// laptop sleeps, and a watchdog inside pauses the sandbox once it has been idle for a while
// (compute billing stops; files and the conversation stay; `lzs resume` wakes it in ~2.5 s).

import { spawnSync, spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import readline from "node:readline/promises";
import { createRequire } from "node:module";

const VERSION = "0.3.0";
const HOME = os.homedir();
const CFG_DIR = process.env.LZS_HOME || path.join(HOME, ".config", "lzs");
const CFG_FILE = path.join(CFG_DIR, "config.json");
const STATE_FILE = path.join(CFG_DIR, "sessions.json");
const REMOTE = "/root/.lzs";
const RATE = { nano: 0.00405, mini: 0.0081, small: 0.0162, medium: 0.0324, large: 0.0648, big: 0.1296 };

// How each agent starts fresh, starts with a first prompt, continues its last conversation,
// gets installed, and reads its login.
const AGENTS = {
  claude: {
    install: "true", // in the claude template already
    start: "claude --dangerously-skip-permissions",
    prompt: "claude --dangerously-skip-permissions",
    cont: "claude --continue --dangerously-skip-permissions || claude --dangerously-skip-permissions",
    env: ["CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY"],
    hint: "run `claude setup-token` on your machine and paste the token (one long-lived token is safe for many sessions at once)",
  },
  codex: {
    install: "command -v codex >/dev/null || npm i -g @openai/codex >/dev/null 2>&1",
    start: "codex --dangerously-bypass-approvals-and-sandbox",
    prompt: "codex --dangerously-bypass-approvals-and-sandbox",
    cont: "codex resume --last --dangerously-bypass-approvals-and-sandbox || codex --dangerously-bypass-approvals-and-sandbox",
    env: ["OPENAI_API_KEY"],
    hint: "paste an OpenAI API key, or leave it empty and run `codex login --device-auth` in the base shell",
  },
  opencode: {
    install: "command -v opencode >/dev/null || npm i -g opencode-ai >/dev/null 2>&1",
    start: "opencode",
    prompt: "opencode --prompt",
    cont: "opencode --continue || opencode",
    env: ["ANTHROPIC_API_KEY", "OPENAI_API_KEY"],
    hint: "paste a provider API key, or leave it empty and run `opencode auth login` in the base shell",
  },
};

// ---------- small helpers ----------
const tty = process.stdout.isTTY;
const c = (n) => (s) => (tty ? `\x1b[${n}m${s}\x1b[0m` : String(s));
const dim = c(2), bold = c(1), green = c(32), red = c(31), yellow = c(33), cyan = c(36), magenta = c(35);
const say = (m) => console.error(dim("lzs ") + m);
const die = (m, code = 1) => { console.error(red("lzs: ") + m); process.exit(code); };
const readJson = (f, d) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return d; } };
const writeJson = (f, v) => { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, JSON.stringify(v, null, 2) + "\n", { mode: 0o600 }); };
const q = (s) => `'${String(s).replace(/'/g, `'\\''`)}'`;
const b64 = (s) => Buffer.from(s).toString("base64");
const secs = (t0) => ((Date.now() - t0) / 1000).toFixed(1);
const sleepMs = (ms) => new Promise((r) => setTimeout(r, ms));
const plain = (s) => String(s).replace(/\x1b\[[0-9;]*m/g, "");
// Shorten to n visible characters; colored text that doesn't fit loses its colors.
const trunc = (s, n) => { const p = plain(s); return p.length <= n ? s : p.slice(0, n - 1) + "…"; };

function lizard(args, { json = false, input, inherit = false, check = true } = {}) {
  const full = json ? [...args, "--json"] : args;
  const r = spawnSync("lizard", full, { encoding: "utf8", input, stdio: inherit ? "inherit" : ["pipe", "pipe", "pipe"], maxBuffer: 64 << 20 });
  if (r.error?.code === "ENOENT") die("the `lizard` CLI is not installed. Run: npm i -g @lizard-build/cli && lizard login");
  if (check && r.status !== 0) die(`lizard ${args.slice(0, 3).join(" ")} failed${r.stderr ? `:\n${r.stderr.trim()}` : ""}`);
  if (!json) return r;
  try { return JSON.parse(r.stdout); } catch { die(`could not read the output of lizard ${args.slice(0, 3).join(" ")}:\n${(r.stdout || r.stderr || "").slice(0, 500)}`); }
}

// The same, without blocking: for asking many sandboxes at once.
function lizardAsync(args, { timeoutMs = 20000 } = {}) {
  return new Promise((resolve) => {
    const p = spawn("lizard", args, { stdio: ["ignore", "pipe", "pipe"] });
    let out = "", err = "";
    const t = setTimeout(() => p.kill("SIGKILL"), timeoutMs);
    p.stdout.on("data", (d) => (out += d));
    p.stderr.on("data", (d) => (err += d));
    p.on("close", (status) => { clearTimeout(t); resolve({ status, stdout: out, stderr: err }); });
    p.on("error", () => { clearTimeout(t); resolve({ status: 1, stdout: "", stderr: "spawn failed" }); });
  });
}

// Run a bash script inside a sandbox. It travels base64-encoded, so no quoting surprises.
const wrap = (script) => ["bash", "-lc", `echo ${b64(script)} | base64 -d | bash`];
function remote(id, script, { check = true, inherit = false } = {}) {
  const r = lizard(["sandbox", "exec", id, "--", ...wrap(script)], { check: false, inherit });
  if (check && r.status !== 0) die(`command in ${id} failed:\n${(r.stderr || r.stdout || "").trim().slice(-2000)}`);
  return r;
}
const remoteAsync = (id, script, opts) => lizardAsync(["sandbox", "exec", id, "--", ...wrap(script)], opts);

const shell = (id) => spawnSync("lizard", ["sandbox", "ssh", id], { stdio: "inherit" }).status ?? 1;

// Runs a line in the sandbox's terminal (the one lizard.build and `lizard sandbox ssh` open).
// Unlike exec, that terminal starts with the agent logins you connected on Lizard (the
// project's Agents page, or `lizard agents login claude`), so this is how a base picks them
// up without you pasting anything. Uses the WebSocket client the lizard CLI ships with.
async function terminalLine(id, line, timeoutMs = 20000) {
  const bin = spawnSync(process.platform === "win32" ? "where" : "which", ["lizard"], { encoding: "utf8" }).stdout.trim().split("\n")[0];
  const pkg = path.join(path.dirname(path.dirname(fs.realpathSync(bin))), "package.json");
  const WebSocket = createRequire(pkg)("ws");
  const lzCfg = readJson(path.join(process.env.LIZARD_HOME ? path.join(process.env.LIZARD_HOME, ".lizard") : path.join(HOME, ".lizard"), "config.json"), {});
  const token = process.env.LIZARD_TOKEN || process.env.LIZARD_API_KEY || lzCfg.credentials?.accessToken;
  if (!token) die("the lizard CLI is not signed in. Run: lizard login");
  const base = new URL(process.env.LIZARD_API_URL || "https://lizard.build");
  base.protocol = base.protocol === "http:" ? "ws:" : "wss:";
  return new Promise((resolve) => {
    const ws = new WebSocket(new URL(`/api/sandboxes/terminal?id=${encodeURIComponent(id)}`, base), { headers: { Authorization: `Bearer ${token}` } });
    let sent = false, out = "";
    const t = setTimeout(() => { try { ws.terminate(); } catch {} resolve({ ok: false, out }); }, timeoutMs);
    ws.on("open", () => ws.send(JSON.stringify({ type: "resize", cols: 200, rows: 50 })));
    ws.on("message", (d) => { out += d.toString(); if (!sent) { sent = true; setTimeout(() => ws.send(Buffer.from(` ${line}; exit\r`), { binary: true }), 300); } });
    ws.on("close", () => { clearTimeout(t); resolve({ ok: sent, out }); });
    ws.on("error", () => { clearTimeout(t); resolve({ ok: false, out }); });
  });
}

async function pool(items, n, fn) {
  const out = new Array(items.length);
  let i = 0;
  await Promise.all(Array.from({ length: Math.min(n, items.length) }, async () => { while (i < items.length) { const k = i++; out[k] = await fn(items[k], k); } }));
  return out;
}

const BOOL_FLAGS = new Set(["yes", "y", "no-attach", "detach", "d", "no-local", "github", "all", "json", "files", "stat", "keep", "help", "h", "version", "v"]);
function parse(argv) {
  const flags = {}, rest = [];
  let pass = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--") { pass = argv.slice(i + 1); break; }
    const m = a.match(/^--?([a-z][\w-]*)(?:=(.*))?$/i);
    if (!m) { rest.push(a); continue; }
    const k = { p: "prompt", n: "name", a: "agent", m: "message" }[m[1]] ?? m[1];
    if (BOOL_FLAGS.has(k)) flags[k] = true;
    else if (m[2] !== undefined) flags[k] = m[2];
    else if (i + 1 < argv.length) flags[k] = argv[++i];
    else die(`--${k} needs a value`);
  }
  if (flags.d || flags.detach) flags["no-attach"] = true;
  return { flags, rest, pass };
}

const config = () => readJson(CFG_FILE, null);
const needConfig = () => config() ?? die("no base snapshot yet. Run: lzs init");
const sessions = () => readJson(STATE_FILE, {});
const byAge = (s) => Object.entries(s).sort((a, b) => Date.parse(a[1].createdAt) - Date.parse(b[1].createdAt));

// Read-modify-write under a lock directory: `lzs fan` / `lzs group` start several at once.
function updateSessions(fn) {
  const lock = STATE_FILE + ".lock";
  fs.mkdirSync(CFG_DIR, { recursive: true });
  for (let i = 0; ; i++) {
    try { fs.mkdirSync(lock); break; } catch {
      if (i > 200) { fs.rmSync(lock, { recursive: true, force: true }); continue; } // stale (~10 s)
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
    }
  }
  try { const s = sessions(); fn(s); writeJson(STATE_FILE, s); } finally { fs.rmSync(lock, { recursive: true, force: true }); }
}

function nextNames(count) {
  const taken = { ...sessions() };
  return Array.from({ length: count }, () => { let n = 1; while (taken[`lzs-${n}`]) n++; taken[`lzs-${n}`] = {}; return `lzs-${n}`; });
}

function findSession(ref) {
  const s = sessions();
  if (!ref) return byAge(s).at(-1) ?? die("no sessions. Start one with: lzs");
  if (s[ref]) return [ref, s[ref]];
  if (/^\d+$/.test(ref) && s[`lzs-${ref}`]) return [`lzs-${ref}`, s[`lzs-${ref}`]];
  return Object.entries(s).find(([, v]) => v.id === ref) ?? die(`no session '${ref}'. See: lzs ls`);
}

function liveSandboxes(cfg) {
  const list = lizard(["sandbox", "ls", "-p", cfg.projectId], { json: true });
  const arr = Array.isArray(list) ? list : list.sandboxes ?? [];
  return new Map(arr.map((x) => [x.id, x]));
}

function notify(title, text) {
  process.stderr.write("\x07");
  if (process.platform === "darwin") spawn("osascript", ["-e", `display notification ${JSON.stringify(text)} with title ${JSON.stringify(title)}`], { stdio: "ignore", detached: true }).on("error", () => {}).unref();
  else if (process.platform === "linux") spawn("notify-send", [title, text], { stdio: "ignore", detached: true }).on("error", () => {}).unref();
}

// ---------- what lives inside the sandbox ----------
// start.sh <agent> <new|continue|prompt> [b64 prompt]: start the agent in tmux (in the session's
// working directory) and the idle watchdog. A running agent is left alone.
const START_SH = String.raw`#!/bin/bash
set -u
L=/root/.lzs
agent="$1"; mode="$2"; prompt="$(echo "\${3:-}" | base64 -d 2>/dev/null)"
[ -f $L/env ] && set -a && . $L/env && set +a
cmd="$(cat $L/agents/$agent.$mode)"
[ "$mode" = prompt ] && cmd="$cmd $(printf %q "$prompt")"
cwd="$(cat $L/cwd 2>/dev/null || echo /workspace)"; mkdir -p "$cwd"
if ! tmux has-session -t agent 2>/dev/null; then
  tmux new-session -d -s agent -c "$cwd" -x 200 -y 50 "bash -lc $(printf %q "$cmd"); echo; echo '[agent exited: Ctrl-b d to detach, or keep using this shell]'; exec bash -l"
  tmux set -g mouse on; tmux set -g history-limit 50000
  tmux set -g status-style 'bg=#0f2a1a,fg=#9be7b4'; tmux set -g status-right " lzs · $(cat $L/name 2>/dev/null) · Ctrl-b d to detach "; tmux set -g status-right-length 80
fi
pkill -f "$L/watchdog.sh" 2>/dev/null
setsid nohup $L/watchdog.sh >$L/watchdog.log 2>&1 </dev/null &
`.replace(/\\\$\{/g, "${");

// The sandbox's own supervisor, so all of this works with your laptop closed:
// - when the agent finishes a turn (its "esc to interrupt" goes away), run the session's check
//   (your tests, say) and notify you (LZS_NOTIFY: ntfy, Slack, Discord or Telegram URL);
// - once nothing has happened for LZS_IDLE_MINUTES (no change on the agent's screen, no keystroke
//   from anyone attached), pause the sandbox. Pausing keeps the files; compute billing stops.
const WATCHDOG_SH = String.raw`#!/bin/bash
L=/root/.lzs
[ -f $L/env ] && set -a && . $L/env && set +a
idle_min="\${LZS_IDLE_MINUTES:-30}"
last=$(date +%s); prev=""; was=""; worked=0

notify() { # $1 title, $2 text
  local u="\${LZS_NOTIFY:-}"; [ -z "$u" ] && return 0
  case "$u" in
    *hooks.slack.com*) curl -fsS -m 10 -H 'Content-Type: application/json' -d "$(node -e 'console.log(JSON.stringify({text:process.argv[1]+"\n"+process.argv[2]}))' "$1" "$2")" "$u" ;;
    *discord.com/api/webhooks*) curl -fsS -m 10 -H 'Content-Type: application/json' -d "$(node -e 'console.log(JSON.stringify({content:"**"+process.argv[1]+"**\n"+process.argv[2]}))' "$1" "$2")" "$u" ;;
    *api.telegram.org*) curl -fsS -m 10 --data-urlencode "text=$1
$2" "$u" ;;
    *) curl -fsS -m 10 -H "Title: $1" -H "Tags: lizard" -d "$2" "$u" ;;
  esac >/dev/null 2>&1
}

run_check() { # writes check.rc / check.log / check.at; returns the exit code
  [ -s $L/check ] || return 0
  echo running > $L/check.rc
  ( cd "$(cat $L/cwd 2>/dev/null || echo /workspace)" && timeout "\${LZS_CHECK_TIMEOUT:-900}" bash -lc "$(cat $L/check)" ) > $L/check.log 2>&1
  local rc=$?; echo $rc > $L/check.rc; date +%s > $L/check.at; return $rc
}

while sleep 10; do
  now=$(date +%s)
  screen=$(tmux capture-pane -p -t agent 2>/dev/null)
  cur=$(printf '%s' "$screen" | md5sum)
  [ "$cur" != "$prev" ] && last=$now && prev="$cur"
  ca=$(tmux list-clients -F '#{client_activity}' 2>/dev/null | sort -n | tail -1)
  [ -n "$ca" ] && [ "$ca" -gt "$last" ] && last=$ca
  echo $last > $L/last_activity

  tail=$(printf '%s' "$screen" | grep -v '^\s*$' | tail -12)
  if printf '%s' "$tail" | grep -qiE 'esc to interrupt|esc interrupt|ctrl\+c to interrupt'; then state=working
  elif printf '%s' "$tail" | grep -qE 'Do you want|\(y/n\)|\[Y/n\]|❯ [0-9]+\.'; then state=asking
  else state=idle; fi
  if [ "$state" = working ]; then worked=$((worked + 1)); fi
  if [ "$was" = working ] && [ "$state" != working ] && [ $worked -ge 1 ]; then
    title=$(tmux display -p -t agent '#{pane_title}' | sed 's/^[^[:alnum:]]*//')
    msg="$(cat $L/name) is done"; [ "$state" = asking ] && msg="$(cat $L/name) is asking you something"
    if [ -s $L/check ]; then
      if run_check; then msg="$msg - check passed"; else msg="$msg - check FAILED"; fi
      last=$(date +%s)
    fi
    notify "$msg" "\${title:-$(cat $L/prompt 2>/dev/null | head -c 200)}"
    worked=0
  fi
  was=$state

  if [ "$idle_min" != 0 ] && [ $((now - last)) -ge $((idle_min * 60)) ]; then
    echo "$(date -u +%FT%TZ) idle \${idle_min}m: pausing"
    sync
    LIZARD_API_KEY="$(cat $L/key)" lizard sandbox pause "$(cat $L/id)" --no-wait && exit 0
    last=$now
  fi
done
`.replace(/\\\$\{/g, "${");

// What `lzs ls` / `lzs watch` read from each running sandbox: the pane's title (Claude Code
// keeps it set to the task), the last screen lines, git progress, and when anything last happened.
const PROBE_SH = String.raw`
L=/root/.lzs
tmux has-session -t agent 2>/dev/null || { echo "NOAGENT"; exit 0; }
echo "TITLE $(tmux display -p -t agent '#{pane_title}')"
echo "LAST $(cat $L/last_activity 2>/dev/null || echo 0) $(date +%s)"
cwd=$(cat $L/cwd 2>/dev/null)
if [ -n "$cwd" ] && [ -d "$cwd/.git" ] && [ -f $L/base ]; then
  cd "$cwd"
  # Against a throwaway index, so new files count too and the agent's own index is untouched.
  export GIT_INDEX_FILE=$(mktemp); cp .git/index $GIT_INDEX_FILE 2>/dev/null; git add -A >/dev/null 2>&1
  st=$(git diff --cached --shortstat $(cat $L/base) 2>/dev/null); rm -f $GIT_INDEX_FILE; unset GIT_INDEX_FILE
  n() { echo "$st" | grep -o "[0-9]* $1" | grep -o '[0-9]*' || echo 0; }
  echo "GIT $(git rev-list --count $(cat $L/base)..HEAD 2>/dev/null || echo 0) $(n insertion) $(n deletion) 0 $(n file)"
fi
[ -f $L/check.rc ] && echo "CHECK $(cat $L/check.rc) $(cat $L/check.at 2>/dev/null || echo 0)"
echo "SCREEN"
tmux capture-pane -p -t agent | sed -e 's/[[:space:]]*$//' | grep -v '^$' | tail -25
`;

// An interactive login shell lands straight in the agent's tmux session (lzs resume, or the
// terminal on lizard.build). Ctrl-b d detaches and closes the connection.
const BASHRC = String.raw`
# lzs: attach to the agent
if [ -z "\${TMUX:-}" ] && [ -t 0 ] && [ -z "\${LZS_NO_ATTACH:-}" ] && [ -f /root/.lzs/id ] && tmux has-session -t agent 2>/dev/null; then
  exec tmux attach -t agent
fi
`.replace(/\\\$\{/g, "${");

// What the screen says about the agent.
function classify(screen) {
  const tail = screen.split("\n").slice(-12).join("\n");
  if (/\[agent exited/.test(tail)) return "exited";
  if (/esc to interrupt|esc interrupt|ctrl\+c to interrupt|Working \(/i.test(tail)) return "working";
  if (/Do you want|\(y\/n\)|\[Y\/n\]|❯ \d+\.|Press Enter to|Allow .*\?/i.test(tail)) return "asking";
  return "waiting";
}

function parseProbe(out) {
  if (!out || /NOAGENT/.test(out)) return { state: "no agent" };
  const get = (k) => (out.match(new RegExp(`^${k} (.*)$`, "m")) ?? [])[1];
  const screen = out.split(/^SCREEN$/m)[1] ?? "";
  const [last, now] = (get("LAST") ?? "0 0").split(" ").map(Number);
  const g = get("GIT")?.split(" ").map((x) => Number(x) || 0);
  const git = g ? { commits: g[0], added: g[1], removed: g[2], untracked: g[3], files: g[4] } : null;
  const ck = get("CHECK")?.split(" ");
  const check = ck ? { state: ck[0] === "running" ? "running" : ck[0] === "0" ? "passed" : "failed", rc: ck[0], at: Number(ck[1]) || 0 } : null;
  let title = (get("TITLE") ?? "").replace(/^[^\p{L}\p{N}]+/u, "").trim();
  if (!title || /^(e2b(\.local)?|localhost|bash|claude( code)?|codex|opencode)$/i.test(title)) {
    // No title from the agent: the last thing it said.
    const said = screen.split("\n").filter((l) => /^\s*(⏺|•|●)\s+\S/.test(l)).at(-1);
    title = said ? said.replace(/^\s*(⏺|•|●)\s+/, "") : "";
  }
  return { state: classify(screen), title, idleS: last && now ? now - last : null, git, check, screen };
}

async function probeAll(entries, live) {
  return pool(entries, 16, async ([name, v]) => {
    const status = live.get(v.id)?.status ?? "gone";
    if (status !== "running") return { name, v, status, state: status };
    const r = await remoteAsync(v.id, PROBE_SH, { timeoutMs: 15000 });
    return { name, v, status, ...(r.status === 0 ? parseProbe(r.stdout) : { state: "unreachable" }) };
  });
}

const STATE_COLOR = { working: cyan, waiting: green, asking: magenta, exited: yellow, paused: dim, pausing: dim, resuming: dim, gone: red, unreachable: red, "no agent": yellow };
const STATE_LABEL = { waiting: "your turn", asking: "asking you" };

// "+120 −30 · 2 new · 3 commits": what the session changed against where it started.
function diffBits(g) {
  if (!g) return "";
  const bits = [];
  if (g.added || g.removed) bits.push(`${green("+" + g.added)} ${red("−" + g.removed)}`);
  if (g.untracked) bits.push(`${g.untracked} new`);
  if (g.commits) bits.push(`${g.commits} commit${g.commits > 1 ? "s" : ""}`);
  return bits.join(" ");
}

function renderTable(rows, cfg) {
  const w = process.stdout.columns || 120;
  const lines = rows.map((r) => {
    const st = (STATE_COLOR[r.state] ?? ((x) => x))((STATE_LABEL[r.state] ?? r.state).padEnd(11));
    const gitBits = diffBits(r.git);
    const check = r.check ? (r.check.state === "passed" ? green("✓ check") : r.check.state === "running" ? cyan("… check") : red("✗ check")) : "";
    const idle = r.status === "running" && r.idleS != null && r.state !== "working" && r.idleS >= 60 ? `idle ${Math.round(r.idleS / 60)}m` : "";
    const text = [r.v.repo?.name, r.title ? trunc(r.title, 60) : r.v.prompt ? trunc(r.v.prompt, 60) : "", gitBits, idle].filter(Boolean);
    const room = Math.max(20, w - 31 - (check ? 9 : 0));
    return `${bold(r.name.padEnd(9))} ${st} ${dim(r.v.agent.padEnd(8))} ${check ? check + " " : ""}${trunc(text.join(" · "), room)}`;
  });
  const running = rows.filter((r) => r.status === "running").length;
  const need = rows.filter((r) => r.state === "asking" || r.state === "waiting").length;
  lines.push(dim(`\n${rows.length} sessions · ${running} running · ~$${(running * (RATE[cfg.size] ?? 0)).toFixed(3)}/h (${cfg.size}) · ${need} waiting for you`));
  return lines.join("\n");
}

// ---------- init ----------
async function cmdInit(flags) {
  const agent = flags.agent || "claude";
  if (!AGENTS[agent]) die(`unknown agent '${agent}' (claude, codex, opencode)`);
  const size = flags.size || "nano";
  const old = config();
  const rl = process.stdin.isTTY && !flags.yes ? readline.createInterface({ input: process.stdin, output: process.stderr }) : null;

  // The agent's login: a long-lived token in the base, so every session starts signed in.
  const tokens = {};
  for (const k of AGENTS[agent].env) if (process.env[k]) tokens[k] = process.env[k];
  // Or the login connected on Lizard for this project: nothing to paste.
  const connected = !Object.keys(tokens).length && agentConnectedOnLizard(agent, flags.project);
  if (connected) say(`using the ${agent} login connected on Lizard (${connected})`);
  if (!Object.keys(tokens).length && !connected && rl) {
    console.error(`\n${bold(`${agent} login`)}: ${AGENTS[agent].hint}.`);
    const v = (await rl.question(`${AGENTS[agent].env[0]} (empty to sign in by hand): `)).trim();
    if (v) tokens[v.startsWith("sk-ant-api") ? "ANTHROPIC_API_KEY" : AGENTS[agent].env[0]] = v;
  }

  // GitHub, so sessions can clone private repos and push branches (lzs push). Opt in.
  let ghToken = process.env.LZS_GH_TOKEN || "";
  const localGh = () => spawnSync("gh", ["auth", "token"], { encoding: "utf8" }).stdout?.trim() || "";
  if (!ghToken && flags.github) ghToken = localGh() || die("--github: `gh auth token` gave nothing. Run `gh auth login` first.");
  else if (!ghToken && rl && localGh()) {
    const a = (await rl.question(`Let sessions use your GitHub login (clone private repos, push branches)? [y/N] `)).trim();
    if (/^y/i.test(a)) ghToken = localGh();
  }
  rl?.close();
  const gitCfg = (k) => spawnSync("git", ["config", "--global", k], { encoding: "utf8" }).stdout?.trim();
  const gitName = gitCfg("user.name"), gitEmail = gitCfg("user.email");

  const t0 = Date.now();
  say(`creating the base sandbox (${size})…`);
  const create = ["sandbox", "create", "-t", "claude", "-s", size, "--timeout", "2h"];
  if (flags.project) create.push("-p", flags.project);
  if (flags.region) create.push("--region", flags.region);
  const sb = lizard(create, { json: true });
  const id = sb.id;
  say(`base sandbox ${id} in project ${sb.projectName ?? sb.projectId}`);

  // One key scoped to the project, kept in the base, lets each sandbox pause itself when idle.
  const key = lizard(["keys", "create", `lzs-${sb.projectName ?? sb.projectId}`.slice(0, 60), "-p", sb.projectId], { json: true });

  say("installing tmux and the agent…");
  const agentFiles = Object.entries(AGENTS).map(([n, a]) =>
    `printf '%s' ${q(a.start)} > $L/agents/${n}.new; printf '%s' ${q(a.prompt)} > $L/agents/${n}.prompt; printf '%s' ${q(a.cont)} > $L/agents/${n}.continue`).join("\n");
  const env = { IS_SANDBOX: "1", LZS_IDLE_MINUTES: String(flags["idle-minutes"] ?? 30), ...tokens };
  if (flags.notify) env.LZS_NOTIFY = flags.notify;
  if (ghToken) env.GH_TOKEN = ghToken;
  remote(id, `set -e
L=${REMOTE}; mkdir -p $L/agents /workspace
command -v tmux >/dev/null || { apt-get update -qq >/dev/null; DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tmux >/dev/null; }
${AGENTS[agent].install}
echo ${b64(START_SH)} | base64 -d > $L/start.sh
echo ${b64(WATCHDOG_SH)} | base64 -d > $L/watchdog.sh
chmod +x $L/*.sh
${agentFiles}
echo ${b64(Object.entries(env).map(([k, v]) => `${k}=${q(v)}`).join("\n") + "\n")} | base64 -d > $L/env
echo ${b64(key.key)} | base64 -d > $L/key
chmod 600 $L/env $L/key
grep -q 'lzs: attach' /root/.bashrc || echo ${b64(BASHRC)} | base64 -d >> /root/.bashrc
${gitName ? `git config --global user.name ${q(gitName)}` : ""}
${gitEmail ? `git config --global user.email ${q(gitEmail)}` : ""}
git config --global advice.detachedHead false
printf '%s\n' __pycache__/ '*.pyc' node_modules/ .venv/ .DS_Store .pytest_cache/ > /root/.gitignore_global && git config --global core.excludesFile /root/.gitignore_global
${ghToken ? `GH_TOKEN=${q(ghToken)} gh auth setup-git >/dev/null 2>&1 || true` : ""}
# Claude Code: no first-run screens, /workspace trusted, bypass mode accepted.
node -e '
const fs=require("fs"),f="/root/.claude.json";let j={};try{j=JSON.parse(fs.readFileSync(f))}catch{}
j.hasCompletedOnboarding=true;j.bypassPermissionsModeAccepted=true;j.projects=j.projects||{};
j.projects["/workspace"]={...(j.projects["/workspace"]||{}),hasTrustDialogAccepted:true,hasCompletedProjectOnboarding:true};
fs.writeFileSync(f,JSON.stringify(j,null,2))'
mkdir -p /root/.claude
node -e '
const fs=require("fs"),f="/root/.claude/settings.json";let j={};try{j=JSON.parse(fs.readFileSync(f))}catch{}
j.skipDangerousModePermissionPrompt=true;fs.writeFileSync(f,JSON.stringify(j,null,2))'
`);

  // Your own setup: CLAUDE.md, skills, agents, commands, and user-level MCP servers.
  if (!flags["no-local"]) pushLocalSetup(id);

  if (connected) {
    // The terminal carries the Lizard-connected logins: keep the agent ones in the base.
    const keys = "CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY|ANTHROPIC_BASE_URL|ANTHROPIC_AUTH_TOKEN|OPENAI_API_KEY|OPENROUTER_API_KEY|MOONSHOT_API_KEY|DEEPSEEK_API_KEY";
    const t = await terminalLine(id, `env | grep -E '^(${keys})=' > ${REMOTE}/agent-env.raw`);
    const r = remote(id, `cd ${REMOTE} && n=0; while IFS='=' read -r k v; do [ -n "$k" ] && printf '%s=%q\\n' "$k" "$v" >> env && n=$((n+1)); done < agent-env.raw; rm -f agent-env.raw; echo $n`, { check: false });
    if (!t.ok || !(Number(r.stdout.trim()) > 0)) die(`could not read the ${agent} login from Lizard; set ${AGENTS[agent].env[0]} and run lzs init again`);
    tokens.__lizard = "1";
  }
  if (!Object.keys(tokens).length) {
    if (!process.stdin.isTTY) die(`no ${agent} login: set ${AGENTS[agent].env.join(" or ")} and run lzs init again`);
    console.error(`\n${bold("Sign in by hand now.")} You are in the base sandbox's shell. Run:\n  ${agent === "claude" ? "claude setup-token   then: echo CLAUDE_CODE_OAUTH_TOKEN=<token> >> /root/.lzs/env" : agent === "codex" ? "codex login --device-auth" : "opencode auth login"}\nthen type ${bold("exit")} to save the base.\n`);
    shell(id);
  }

  say("saving the base snapshot…");
  const snap = lizard(["sandbox", "snapshot", id, "--name", "lzs-base"], { json: true });
  const snapId = snap.id ?? snap.snapshotId;
  if (!snapId) die(`snapshot answered without an id: ${JSON.stringify(snap).slice(0, 300)}`);
  lizard(["sandbox", "rm", id], { check: false });
  if (old?.keyId && old.keyId !== key.id && old.projectId === sb.projectId) say(`older sessions still use key ${old.keyId}; delete it once they are gone: lizard keys rm ${old.keyId}`);
  writeJson(CFG_FILE, { version: 3, agent, size, notify: !!flags.notify, login: connected ? "lizard" : "token", projectId: sb.projectId, projectName: sb.projectName, region: sb.region, snapshot: snapId, keyId: key.id, github: !!ghToken, createdAt: new Date().toISOString() });
  console.error(`\n${green("ready")} in ${secs(t0)} s · base ${snapId} (${size}${ghToken ? ", GitHub" : ""})\n\n  ${bold("lzs")}                    a fresh session\n  ${bold("lzs .")}                  this repo in a fresh session\n  ${bold(`lzs fan 5 . -p "…"`)}     five agents on one task, then ${bold("lzs watch")}\n`);
}

// Is this agent's login connected on Lizard (Agents page / `lizard agents login`)?
function agentConnectedOnLizard(agent, project) {
  const kinds = { claude: ["claude", "anthropic_key", "openrouter_key"], codex: ["openai_key"], opencode: ["anthropic_key", "openai_key", "openrouter_key"] }[agent] ?? [];
  const r = lizard(["agents", "status", ...(project ? ["--project", project] : [])], { json: true, check: false });
  const list = r?.credentials ?? [];
  const hit = list.find((c) => kinds.includes(c.kind) && c.connected);
  return hit ? hit.label : null;
}

function pushLocalSetup(id) {
  const claudeDir = path.join(HOME, ".claude");
  const items = ["CLAUDE.md", "skills", "agents", "commands"].filter((x) => fs.existsSync(path.join(claudeDir, x)));
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "lzs-"));
  try {
    if (items.length) {
      const tgz = path.join(tmp, "claude.tgz");
      const r = spawnSync("tar", ["-czf", tgz, "-C", claudeDir, "--exclude=.git", "--exclude=node_modules", ...items], { stdio: "pipe" });
      if (r.status === 0) {
        lizard(["sandbox", "files", "put", id, tgz, "/tmp/lzs-claude.tgz"]);
        remote(id, "mkdir -p /root/.claude && tar -xzf /tmp/lzs-claude.tgz -C /root/.claude && rm /tmp/lzs-claude.tgz");
        say(`copied ~/.claude: ${items.join(", ")}`);
      }
    }
    // User-level MCP servers from ~/.claude.json (only that key: the rest is your local state).
    const local = readJson(path.join(HOME, ".claude.json"), {});
    if (local.mcpServers && Object.keys(local.mcpServers).length) {
      const f = path.join(tmp, "mcp.json");
      fs.writeFileSync(f, JSON.stringify(local.mcpServers));
      lizard(["sandbox", "files", "put", id, f, "/tmp/lzs-mcp.json"]);
      remote(id, `node -e 'const fs=require("fs"),f="/root/.claude.json";const j=JSON.parse(fs.readFileSync(f));j.mcpServers={...(j.mcpServers||{}),...JSON.parse(fs.readFileSync("/tmp/lzs-mcp.json"))};fs.writeFileSync(f,JSON.stringify(j,null,2))' && rm /tmp/lzs-mcp.json`);
      say(`copied MCP servers: ${Object.keys(local.mcpServers).join(", ")}`);
    }
  } finally { fs.rmSync(tmp, { recursive: true, force: true }); }
}

// ---------- the code a session works on ----------
// A local repo goes in as it is right now: history, branch, uncommitted and untracked files
// (not what .gitignore ignores). The session works on branch lzs/<name>; `lzs pull` fetches it back.
function packLocalRepo(dir) {
  const git = (...a) => spawnSync("git", ["-C", dir, ...a], { encoding: "utf8" }).stdout?.trim();
  const top = git("rev-parse", "--show-toplevel");
  if (!top) die(`${dir} is not inside a git repository`);
  const head = git("rev-parse", "HEAD");
  if (!head) die(`${top} has no commits yet: commit once, then lzs .`);
  if (path.resolve(top, git("rev-parse", "--git-dir")) !== path.join(top, ".git")) die(`${top} keeps its git data elsewhere (a worktree or submodule); clone it normally first`);
  const files = spawnSync("git", ["-C", top, "ls-files", "-z", "-co", "--exclude-standard"], { maxBuffer: 256 << 20 }).stdout;
  const tgz = path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lzs-")), "repo.tgz");
  const r = spawnSync("tar", ["-czf", tgz, "-C", top, "--null", "-T", "-"], { input: Buffer.concat([files, Buffer.from(".git\0")]), stdio: ["pipe", "ignore", "pipe"] });
  if (r.status !== 0) die(`could not pack ${top}: ${r.stderr}`);
  const mb = fs.statSync(tgz).size / 1e6;
  if (mb > 500) die(`${top} packs to ${mb.toFixed(0)} MB, too big to send; use --repo owner/name to clone it in the sandbox`);
  return { top, head, tgz, mb, name: path.basename(top) };
}

function repoFromArgs(rest, flags) {
  if (flags.repo) return { kind: "github", slug: flags.repo.replace(/^https:\/\/github\.com\//, "").replace(/\.git$/, "") };
  const dir = rest[0];
  if (!dir) return null;
  const p = path.resolve(dir.replace(/^~(?=\/|$)/, HOME));
  if (fs.existsSync(p) && fs.statSync(p).isDirectory()) return { kind: "local", dir: p };
  die(`'${dir}' is not a command or a folder. See: lzs --help`);
}

// ---------- sessions ----------
async function newSession({ name, agent, prompt, repo, pack, attach, check, group }) {
  const cfg = needConfig();
  if (!AGENTS[agent]) die(`unknown agent '${agent}'`);
  const t0 = Date.now();
  const sb = lizard(["sandbox", "restore", cfg.snapshot, "--timeout", "0", "-p", cfg.projectId], { json: true });
  const rec = { id: sb.id, agent, createdAt: new Date().toISOString(), ...(prompt ? { prompt: trunc(prompt, 200) } : {}), ...(check ? { check } : {}), ...(group ? { group } : {}) };
  updateSessions((all) => { all[name] = rec; });
  let cwd = "/workspace", setup = "";
  if (repo?.kind === "local") {
    lizard(["sandbox", "files", "put", sb.id, pack.tgz, "/tmp/lzs-repo.tgz"]);
    cwd = `/workspace/${pack.name}`;
    setup = `mkdir -p ${q(cwd)} && tar -xzf /tmp/lzs-repo.tgz -C ${q(cwd)} && rm /tmp/lzs-repo.tgz && cd ${q(cwd)} && git checkout -q -b lzs/${name} && git rev-parse HEAD > ${REMOTE}/base`;
    rec.repo = { kind: "local", name: pack.name, local: pack.top, path: cwd, base: pack.head, branch: `lzs/${name}` };
  } else if (repo?.kind === "github") {
    const short = repo.slug.split("/").pop();
    cwd = `/workspace/${short}`;
    setup = `cd /workspace && if [ -n "$GH_TOKEN" ]; then gh repo clone ${q(repo.slug)} ${q(short)} -- -q; else git clone -q ${q(`https://github.com/${repo.slug}.git`)} ${q(short)}; fi && cd ${q(short)} && git checkout -q -b lzs/${name} && git rev-parse HEAD > ${REMOTE}/base`;
    rec.repo = { kind: "github", name: short, slug: repo.slug, path: cwd, branch: `lzs/${name}` };
  }
  const r = remote(sb.id, `set -e
GH_TOKEN=; [ -f ${REMOTE}/env ] && set -a && . ${REMOTE}/env && set +a
echo ${q(sb.id)} > ${REMOTE}/id; echo ${q(name)} > ${REMOTE}/name; echo ${q(cwd)} > ${REMOTE}/cwd
printf '%s' ${q(check ?? "")} > ${REMOTE}/check; printf '%s' ${q(prompt ?? "")} > ${REMOTE}/prompt
${setup}
node -e 'const fs=require("fs"),f="/root/.claude.json";const j=JSON.parse(fs.readFileSync(f));j.projects[${JSON.stringify(cwd)}]={hasTrustDialogAccepted:true,hasCompletedProjectOnboarding:true};fs.writeFileSync(f,JSON.stringify(j))' 2>/dev/null || true
${REMOTE}/start.sh ${q(agent)} ${prompt ? "prompt" : "new"} ${q(b64(prompt ?? ""))}`, { check: false });
  updateSessions((all) => { all[name] = rec; });
  if (r.status !== 0) die(`${name} (${sb.id}) started, but setting it up failed:\n${(r.stderr || r.stdout).trim().slice(-1500)}`);
  say(`${bold(name)} (${sb.id}, ${agent}${rec.repo ? `, ${rec.repo.name} on ${rec.repo.branch}` : ""}) ready in ${secs(t0)} s${attach ? " · Ctrl-b d to detach" : ""}`);
  return attach ? shell(sb.id) : 0;
}

async function cmdNew(rest, flags) {
  const cfg = needConfig();
  const repo = repoFromArgs(rest, flags);
  const pack = repo?.kind === "local" ? packLocalRepo(repo.dir) : null;
  if (pack && pack.mb > 20) say(`sending ${pack.name} (${pack.mb.toFixed(0)} MB)…`);
  const name = flags.name || nextNames(1)[0];
  if (sessions()[name]) die(`session '${name}' exists. Use: lzs resume ${name}`);
  try {
    return await newSession({ name, agent: flags.agent || cfg.agent, prompt: flags.prompt, repo, pack, attach: !flags["no-attach"], check: flags.check, group: flags.group });
  } finally { if (pack) fs.rmSync(path.dirname(pack.tgz), { recursive: true, force: true }); }
}

// N agents on the same task (or none), started in parallel, nobody attached.
async function cmdFan(rest, flags) {
  const cfg = needConfig();
  const n = parseInt(rest[0], 10);
  if (!(n >= 1 && n <= 50)) die(`usage: lzs fan <1-50> [. | --repo owner/name] [-p "task"]`);
  const repo = repoFromArgs(rest.slice(1), flags);
  if (repo?.kind === "local") packLocalRepo(repo.dir); // fail early, before starting anything
  const names = nextNames(n);
  const group = `fan-${Date.now().toString(36)}`;
  const t0 = Date.now();
  say(`starting ${n} ${flags.agent || cfg.agent} sessions${repo ? ` on ${path.basename(repo.dir ?? repo.slug)}` : ""}…`);
  // Each one in its own lzs process, so they really run side by side.
  const args = (nm) => ["new", ...(repo?.kind === "local" ? [repo.dir] : []), ...(repo?.kind === "github" ? ["--repo", repo.slug] : []), "--name", nm, "--detach", "--group", group, ...(flags.agent ? ["--agent", flags.agent] : []), ...(flags.prompt ? ["--prompt", flags.prompt] : []), ...(flags.check ? ["--check", flags.check] : [])];
  const results = await pool(names, 10, (nm) => new Promise((resolve) => {
    const p = spawn(process.execPath, [process.argv[1], ...args(nm)], { stdio: ["ignore", "ignore", "pipe"], env: process.env });
    let err = ""; p.stderr.on("data", (d) => (err += d));
    p.on("close", (code) => {
      const took = (err.match(/ready in ([\d.]+) s/) ?? [])[1];
      console.error(code === 0 ? `  ${green("✓")} ${nm}${took ? dim(` ${took} s`) : ""}` : `  ${red("✗")} ${nm}: ${err.trim().split("\n").slice(-2).join(" ")}`);
      resolve(code === 0);
    });
  }));
  const ok = results.filter(Boolean).length;
  console.error(`\n${ok}/${n} running after ${secs(t0)} s · ${bold("lzs watch")} to follow them${flags.check ? `; each runs ${bold(flags.check)} when it finishes` : ""} · ${bold("lzs diff")} to compare · ${bold("lzs pick <name>")} to keep the best`);
  return ok === n ? 0 : 1;
}

async function wake(name, v, live) {
  if (live?.status === "paused" || live?.status === "pausing") {
    const t0 = Date.now();
    lizard(["sandbox", "resume", v.id]);
    remote(v.id, `${REMOTE}/start.sh ${q(v.agent)} continue`);
    say(`${bold(name)} woke in ${secs(t0)} s`);
    return true;
  }
  return false;
}

async function cmdResume(ref, flags) {
  const cfg = needConfig();
  const [name, v] = findSession(ref);
  const live = liveSandboxes(cfg).get(v.id);
  if (!live) die(`${name}'s sandbox ${v.id} is gone. Remove it with: lzs rm ${name}`);
  if (!(await wake(name, v, live))) remote(v.id, `${REMOTE}/start.sh ${q(v.agent)} continue`); // no-op when the agent runs
  return flags["no-attach"] ? 0 : shell(v.id);
}

async function cmdLs(flags) {
  const cfg = needConfig();
  const entries = byAge(sessions());
  if (!entries.length) { console.log("no sessions. Start one with: lzs"); return 0; }
  const rows = await probeAll(entries, liveSandboxes(cfg));
  if (flags.json) { console.log(JSON.stringify(rows.map(({ v, screen, ...r }) => ({ ...r, id: v.id, agent: v.agent, repo: v.repo ?? null, prompt: v.prompt ?? null })), null, 2)); return 0; }
  console.log(renderTable(rows, cfg));
  return 0;
}

// A live board of every session; a bell (and a desktop notification) when one stops working.
async function cmdWatch(flags) {
  const cfg = needConfig();
  const every = Math.max(3, parseInt(flags.every ?? "5", 10)) * 1000;
  const prev = new Map();
  const restore = () => { if (tty) process.stdout.write("\x1b[?25h\x1b[?1049l"); };
  process.on("SIGINT", () => { restore(); process.exit(0); });
  if (tty) process.stdout.write("\x1b[?1049h\x1b[?25l");
  for (;;) {
    const entries = byAge(sessions());
    const rows = entries.length ? await probeAll(entries, liveSandboxes(cfg)) : [];
    const needs = rows.filter((r) => prev.get(r.name) === "working" && ["waiting", "asking", "exited"].includes(r.state));
    for (const r of rows) prev.set(r.name, r.state);
    if (tty) process.stdout.write("\x1b[H\x1b[2J");
    console.log(`${bold("lzs watch")} ${dim(`· every ${every / 1000} s · Ctrl-C to stop · ${new Date().toLocaleTimeString()}`)}\n`);
    console.log(rows.length ? renderTable(rows, cfg) : "no sessions. Start one with: lzs");
    if (needs.length) notify("lzs", needs.map((r) => `${r.name} ${r.state === "asking" ? "is asking you something" : r.state === "exited" ? "exited" : "is done"}${r.title ? `: ${r.title}` : ""}`).join("\n"));
    await sleepMs(every);
  }
}

// The agent's screen right now, without attaching.
async function cmdPeek(ref, flags) {
  const cfg = needConfig();
  const [name, v] = findSession(ref);
  const st = liveSandboxes(cfg).get(v.id)?.status ?? "gone";
  if (st !== "running") die(`${name} is ${st}${st === "paused" ? ` (lzs resume ${name})` : ""}`);
  const n = parseInt(flags.lines ?? "40", 10);
  const r = remote(v.id, `tmux capture-pane -p -e -t agent -S -${n} | sed -e 's/[[:space:]]*$//' | cat -s | tail -${n}`);
  process.stdout.write(r.stdout + "\x1b[0m");
  return 0;
}

// Type into the agent without attaching: a follow-up, an answer, a new task.
async function cmdSend(ref, text, flags) {
  const cfg = needConfig();
  if (!text) die(`usage: lzs send <name> "text"  |  lzs send --all "text"`);
  const targets = flags.all ? byAge(sessions()) : [findSession(ref)];
  const live = liveSandboxes(cfg);
  await pool(targets, 10, async ([name, v]) => {
    const l = live.get(v.id);
    if (!l) { say(`${name} is gone, skipped`); return; }
    if (await wake(name, v, l)) await sleepMs(4000); // let the agent come up before typing
    const r = await remoteAsync(v.id, `tmux send-keys -t agent -l ${q(text)} && sleep 0.3 && tmux send-keys -t agent Enter`);
    say(r.status === 0 ? `${name} ← ${trunc(text, 60)}` : `${name}: send failed`);
  });
  return 0;
}

// The work, back on this machine. A session on your local repo comes back as branch lzs/<name>
// in that repo (git fetch from a bundle: no GitHub needed); otherwise /workspace is copied here.
async function cmdPull(ref, flags) {
  const cfg = needConfig();
  const [name, v] = findSession(ref);
  const live = liveSandboxes(cfg).get(v.id);
  if (!live) die(`${name}'s sandbox is gone`);
  await wake(name, v, live);
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "lzs-"));
  try {
    if (v.repo?.kind === "local" && !flags.files) {
      if (!fs.existsSync(path.join(v.repo.local, ".git"))) die(`${v.repo.local} is gone; lzs pull ${name} --files copies the files instead`);
      // The commit is named after what the agent says it did (its terminal title), else the task.
      const msg = flags.message ? q(flags.message) : `"$(t=$(tmux display -p -t agent '#{pane_title}' 2>/dev/null | sed 's/^[^[:alnum:]]*//'); [ -n "$t" ] && [ "$t" != e2b.local ] && echo "$t" || head -c 72 ${REMOTE}/prompt 2>/dev/null || echo 'lzs ${name}')"`;
      const r = remote(v.id, `cd ${q(v.repo.path)} && git add -A && { git diff --cached --quiet || git commit -q -m ${msg}; } && \
if [ "$(git rev-list --count ${v.repo.base}..HEAD)" = 0 ]; then echo NOCHANGES; else git bundle create -q /tmp/lzs.bundle ${v.repo.base}..HEAD && echo BUNDLED; fi`);
      if (/NOCHANGES/.test(r.stdout)) { console.log(`${name}: no changes yet`); return 0; }
      const bundle = path.join(tmp, "lzs.bundle");
      lizard(["sandbox", "files", "get", v.id, "/tmp/lzs.bundle", bundle]);
      const f = spawnSync("git", ["-C", v.repo.local, "fetch", "-q", "--force", bundle, `HEAD:refs/heads/${v.repo.branch}`], { encoding: "utf8" });
      if (f.status !== 0) die(`git fetch failed: ${f.stderr}`);
      const g = (...a) => spawnSync("git", ["-C", v.repo.local, ...a], { encoding: "utf8" }).stdout.trim();
      const stat = g("diff", "--shortstat", `${v.repo.base}...${v.repo.branch}`);
      const log = g("log", "--oneline", `${v.repo.base}..${v.repo.branch}`);
      console.log(`${green("✓")} ${bold(v.repo.branch)} in ${v.repo.local}${stat ? dim(` · ${stat}`) : ""}\n${log.split("\n").slice(0, 8).map((l) => dim("  " + l)).join("\n")}\n\n  git diff ${v.repo.base.slice(0, 8)}...${v.repo.branch}\n  git merge ${v.repo.branch}`);
      return 0;
    }
    const dest = path.resolve(flags.to || path.join(CFG_DIR, "pulled", name));
    fs.mkdirSync(dest, { recursive: true });
    remote(v.id, `cd / && tar -czf /tmp/lzs-pull.tgz --exclude=node_modules --exclude=.venv workspace $(ls -d root/.claude/projects root/.codex/sessions root/.local/share/opencode 2>/dev/null)`);
    const tgz = path.join(tmp, "pull.tgz");
    lizard(["sandbox", "files", "get", v.id, "/tmp/lzs-pull.tgz", tgz]);
    remote(v.id, "rm -f /tmp/lzs-pull.tgz", { check: false });
    spawnSync("tar", ["-xzf", tgz, "-C", dest], { stdio: "inherit" });
    console.log(`${name} → ${dest}`);
    return 0;
  } finally { fs.rmSync(tmp, { recursive: true, force: true }); }
}

// What a session changed since it started. With a name: the diff itself (committed, uncommitted
// and new files). Without: every session of the last fan-out (or --all) side by side, so the
// best attempt stands out: check result, size of the change, what the agent says it did.
async function cmdDiff(ref, flags) {
  const cfg = needConfig();
  if (ref && !flags.all) {
    const [name, v] = findSession(ref);
    if (!v.repo) die(`${name} has no repository`);
    await wake(name, v, liveSandboxes(cfg).get(v.id));
    const color = tty ? "-c color.ui=always" : "";
    const r = remote(v.id, `cd ${q(v.repo.path)} && export GIT_INDEX_FILE=$(mktemp) && { cp .git/index $GIT_INDEX_FILE 2>/dev/null; git add -A >/dev/null 2>&1; \
git ${color} diff --cached ${flags.stat ? "--stat" : ""} $(cat ${REMOTE}/base); rm -f $GIT_INDEX_FILE; true; }`);
    if (!r.stdout.trim()) { console.log(`${name}: no changes yet`); return 0; }
    if (tty && !flags.stat && r.stdout.split("\n").length > (process.stdout.rows || 40)) spawnSync("less", ["-R"], { input: r.stdout, stdio: ["pipe", "inherit", "inherit"] });
    else process.stdout.write(r.stdout);
    return 0;
  }
  const all = byAge(sessions()).filter(([, v]) => v.repo);
  const lastGroup = all.map(([, v]) => v.group).filter(Boolean).at(-1);
  const entries = flags.all || !lastGroup ? all : all.filter(([, v]) => v.group === lastGroup);
  if (!entries.length) { console.log("no sessions with a repository. Start some with: lzs fan 3 . -p \"…\""); return 0; }
  const rows = await probeAll(entries, liveSandboxes(cfg));
  // Passing checks first, then the smaller change.
  const rank = (r) => [r.check?.state === "passed" ? 0 : r.check ? 2 : 1, (r.git?.added ?? 0) + (r.git?.removed ?? 0)];
  rows.sort((a, b) => { const x = rank(a), y = rank(b); return x[0] - y[0] || x[1] - y[1]; });
  const w = process.stdout.columns || 120;
  for (const r of rows) {
    const ck = r.check ? (r.check.state === "passed" ? green("✓ passed") : r.check.state === "running" ? cyan("… running") : red("✗ failed")) : dim("no check");
    const g = r.git ? `${green(("+" + r.git.added).padStart(6))} ${red(("−" + r.git.removed).padEnd(6))} ${String(r.git.files).padStart(3)} file${r.git.files === 1 ? " " : "s"}` : dim("     (paused)          ");
    console.log(`${bold(r.name.padEnd(9))} ${(STATE_COLOR[r.state] ?? ((x) => x))((STATE_LABEL[r.state] ?? r.state).padEnd(11))} ${ck.padEnd(tty ? 17 : 8)} ${g}  ${trunc(r.title || r.v.prompt || "", Math.max(20, w - 62))}`);
  }
  console.log(dim(`\n${bold("lzs diff <name>")} for one diff · ${bold("lzs pick <name>")} to keep it and delete the others`));
  return 0;
}

// Keep one attempt: bring its work here (lzs pull) and delete the other sessions of its fan-out.
async function cmdPick(ref, flags) {
  needConfig();
  const [name, v] = findSession(ref);
  const code = await cmdPull(name, flags);
  if (code !== 0 || flags.keep || !v.group) return code;
  const others = byAge(sessions()).filter(([n, o]) => o.group === v.group && n !== name).map(([n]) => n);
  if (!others.length) return 0;
  if (process.stdin.isTTY && !flags.yes) {
    const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
    const a = (await rl.question(`delete the other attempts (${others.join(", ")})? [Y/n] `)).trim();
    rl.close();
    if (/^n/i.test(a)) return 0;
  } else if (!flags.yes) { say(`other attempts kept (${others.join(", ")}); add --yes to delete them`); return 0; }
  return cmdRm(others, {});
}

// Run the session's check (tests, a build, a linter) now, in every sandbox at once.
async function cmdCheck(refs, flags) {
  const cfg = needConfig();
  const cmd = flags.check ?? flags.run;
  const targets = flags.all || !refs.length ? byAge(sessions()).filter(([, v]) => v.repo || cmd) : refs.map((r) => findSession(r));
  const live = liveSandboxes(cfg);
  const t0 = Date.now();
  await pool(targets, 10, async ([name, v]) => {
    const l = live.get(v.id);
    if (!l) return console.log(`${bold(name.padEnd(9))} ${red("gone")}`);
    await wake(name, v, l);
    const r = await remoteAsync(v.id, `L=${REMOTE}; [ -f $L/env ] && set -a && . $L/env && set +a
${cmd ? `printf '%s' ${q(cmd)} > $L/check` : ""}
[ -s $L/check ] || { echo NOCHECK; exit 0; }
echo running > $L/check.rc
( cd "$(cat $L/cwd 2>/dev/null || echo /workspace)" && timeout "\${LZS_CHECK_TIMEOUT:-900}" bash -lc "$(cat $L/check)" ) > $L/check.log 2>&1
rc=$?; echo $rc > $L/check.rc; date +%s > $L/check.at
echo "RC $rc"; tail -15 $L/check.log`.replace(/\\\$\{/g, "${"), { timeoutMs: 20 * 60000 });
    if (/NOCHECK/.test(r.stdout)) return console.log(`${bold(name.padEnd(9))} ${dim("no check set (lzs check " + name + " --check \"npm test\")")}`);
    const rc = (r.stdout.match(/^RC (\d+)/m) ?? [])[1];
    const tail = r.stdout.split(/^RC \d+$/m)[1]?.trim() ?? "";
    console.log(`${bold(name.padEnd(9))} ${rc === "0" ? green("✓ passed") : red(`✗ failed (exit ${rc ?? "?"})`)}`);
    if (rc !== "0" && tail) console.log(dim(tail.split("\n").slice(-6).map((l) => "    " + l).join("\n")));
  });
  console.log(dim(`\n${secs(t0)} s`));
  return 0;
}

// Commit and push the session's branch to GitHub, and open a pull request.
async function cmdPush(ref, flags) {
  const cfg = needConfig();
  const [name, v] = findSession(ref);
  if (!v.repo) die(`${name} has no repository (start one with lzs . or lzs --repo owner/name)`);
  await wake(name, v, liveSandboxes(cfg).get(v.id));
  const msg = flags.message || `lzs ${name}`;
  const r = remote(v.id, `GH_TOKEN=; [ -f ${REMOTE}/env ] && set -a && . ${REMOTE}/env && set +a
cd ${q(v.repo.path)} || exit 1
git add -A; git diff --cached --quiet || git commit -q -m ${q(msg)}
[ -n "$GH_TOKEN" ] || { echo NOGH; exit 0; }
git remote get-url origin >/dev/null 2>&1 || { echo NOREMOTE; exit 0; }
git push -q -u origin HEAD:refs/heads/${v.repo.branch} 2>&1 || exit 1
${flags.pr === "no" ? "" : `gh pr create --fill --head ${v.repo.branch} 2>&1 | tail -1 || true`}`, { check: false });
  if (/NOGH/.test(r.stdout)) die("this base has no GitHub login: run lzs init --github, or bring the branch here with lzs pull");
  if (/NOREMOTE/.test(r.stdout)) die("the repository has no origin remote");
  if (r.status !== 0) die((r.stderr || r.stdout).trim());
  console.log(`${green("✓")} pushed ${v.repo.branch}${r.stdout.trim() ? `\n${r.stdout.trim()}` : ""}`);
  return 0;
}

// A dev server in the session, on a URL you can open.
async function cmdOpen(ref, port) {
  needConfig();
  if (!/^\d+$/.test(port ?? "")) die("usage: lzs open <name> <port>");
  const [, v] = findSession(ref);
  const r = lizard(["sandbox", "expose", v.id, port], { json: true });
  const url = r.url ?? r.publicUrl ?? r.urls?.[0];
  if (!url) die(`expose answered without a URL: ${JSON.stringify(r).slice(0, 300)}`);
  console.log(url);
  if (tty) spawn(process.platform === "darwin" ? "open" : "xdg-open", [url], { stdio: "ignore", detached: true }).on("error", () => {}).unref();
  return 0;
}

function cmdStop(refs, flags) {
  needConfig();
  const targets = flags.all ? Object.keys(sessions()) : refs;
  if (!targets.length) die("usage: lzs stop <name>... | --all");
  for (const r of targets) {
    const [name, v] = findSession(r);
    const res = lizard(["sandbox", "pause", v.id, "--no-wait"], { check: false });
    say(res.status === 0 ? `${name} paused (files and conversation kept, compute billing stopped)` : `${name}: ${(res.stderr || "").trim()}`);
  }
  return 0;
}

function cmdRm(refs, flags) {
  needConfig();
  const targets = flags.all ? Object.keys(sessions()) : refs;
  if (!targets.length) die("usage: lzs rm <name>... | --all");
  for (const r of targets) {
    const [name, v] = findSession(r);
    lizard(["sandbox", "rm", v.id], { check: false });
    updateSessions((all) => { delete all[name]; });
    say(`${name} deleted`);
  }
  return 0;
}

// N sessions side by side in tmux panes, each its own sandbox.
async function cmdGroup(rest, flags) {
  needConfig();
  const count = Math.max(1, Math.min(16, parseInt(rest[0] || "4", 10)));
  if (!process.env.TMUX) die(`run lzs group inside tmux (tmux new -s agents), or use lzs fan ${count} and lzs watch`);
  const repo = repoFromArgs(rest.slice(1), flags);
  const names = nextNames(count);
  const env = process.env.LZS_HOME ? `LZS_HOME=${q(process.env.LZS_HOME)} ` : "";
  const extra = [repo?.kind === "local" ? q(repo.dir) : "", repo?.kind === "github" ? `--repo ${q(repo.slug)}` : "", flags.agent ? `--agent ${q(flags.agent)}` : "", flags.prompt ? `--prompt ${q(flags.prompt)}` : ""].join(" ");
  for (const name of names.slice(1)) {
    spawnSync("tmux", ["split-window", "-d", `${env}${q(process.execPath)} ${q(process.argv[1])} new ${extra} --name ${name}; printf 'session ended, Enter to close'; read _`], { stdio: "inherit" });
    spawnSync("tmux", ["select-layout", "tiled"], { stdio: "ignore" });
  }
  return cmdNew(rest.slice(1), { ...flags, name: names[0] });
}

function help() {
  console.log(`${bold("lzs")} ${VERSION}: coding agents in Lizard sandboxes, one command per session

${bold("Start")}
  lzs init [--agent claude|codex|opencode] [--size nano|mini|small] [--github]
           [--notify URL] [--idle-minutes 30] [--project P]  build your base snapshot (once); URL =
                                                             ntfy/Slack/Discord/Telegram, pinged
                                                             when an agent finishes, laptop closed
  lzs [. | DIR | --repo owner/name] [-p "task"] [-d]         a fresh session (. = this repo)
  lzs fan N [. | --repo owner/name] -p "task" [--check CMD]  N agents on one task; CMD (your tests)
                                                             runs in each one when it finishes
  lzs group N [.] [-p "task"]                                N sessions side by side (inside tmux)

${bold("Follow")}
  lzs ls                                                     every session: working, your turn, asking
  lzs watch                                                  the same, live; a bell when one needs you
  lzs peek <name>                                            its screen, without attaching
  lzs send <name> "text" | --all "text"                      type into the agent without attaching
  lzs resume [name]                                          attach (wakes a paused one in ~2.5 s)

${bold("Compare")}
  lzs diff                                                   the last fan-out side by side: check,
                                                             size of change, what each agent did
  lzs diff <name> [--stat]                                   one session's diff
  lzs check [name...] [--check CMD]                          run the check now, everywhere at once
  lzs pick <name>                                            keep it (as a branch), delete the rest

${bold("Ship")}
  lzs pull <name>                                            the work as branch lzs/<name> in your repo
  lzs push <name>                                            push that branch and open a pull request
  lzs open <name> <port>                                     a URL for a dev server in the session

${bold("Tidy")}
  lzs stop <name> | --all                                    pause now (files kept, billing stops)
  lzs rm <name> | --all                                      delete

Inside a session: Ctrl-b d detaches (the agent keeps going), Ctrl-b c opens a shell next to it.
Idle sessions pause themselves after 30 minutes. Needs: npm i -g @lizard-build/cli && lizard login`);
}

// ---------- main ----------
const COMMANDS = new Set(["init", "new", "fan", "group", "resume", "attach", "a", "ls", "list", "watch", "w", "peek", "send", "pull", "push", "open", "stop", "pause", "rm", "delete", "diff", "pick", "check", "help"]);
const argv = process.argv.slice(2);
const sub = argv[0] && COMMANDS.has(argv[0]) ? argv[0] : "";
const { flags, rest, pass } = parse(sub ? argv.slice(1) : argv);
if (pass.length && !flags.prompt) flags.prompt = pass.join(" ");
if (flags.version || flags.v) { console.log(VERSION); process.exit(0); }
if (flags.help || flags.h || sub === "help") { help(); process.exit(0); }

let code = 0;
switch (sub) {
  case "": case "new": code = await cmdNew(rest, flags); break;
  case "init": await cmdInit(flags); break;
  case "fan": code = await cmdFan(rest, flags); break;
  case "group": code = await cmdGroup(rest, flags); break;
  case "resume": case "attach": case "a": code = await cmdResume(rest[0], flags); break;
  case "ls": case "list": code = await cmdLs(flags); break;
  case "watch": case "w": code = await cmdWatch(flags); break;
  case "peek": code = await cmdPeek(rest[0], flags); break;
  case "send": code = await cmdSend(flags.all ? null : rest[0], (flags.all ? rest : rest.slice(1)).join(" "), flags); break;
  case "pull": code = await cmdPull(rest[0], flags); break;
  case "diff": code = await cmdDiff(rest[0], flags); break;
  case "pick": code = await cmdPick(rest[0], flags); break;
  case "check": code = await cmdCheck(rest, flags); break;
  case "push": code = await cmdPush(rest[0], flags); break;
  case "open": code = await cmdOpen(rest[0], rest[1]); break;
  case "stop": case "pause": code = cmdStop(rest, flags); break;
  case "rm": case "delete": code = cmdRm(rest, flags); break;
}
process.exit(code ?? 0);
